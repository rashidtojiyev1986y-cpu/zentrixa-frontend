        .word-card:hover .word-uz {
            color: #7C3AED;
            transform: translateX(5px);
        }

        .word-en {
            font-size: 1.2em;
            color: #94A3B8;
            display: none;
        }

        .word-card.flipped .word-uz {
            display: none;
        }

        .word-card.flipped .word-en {
            display: block;
            color: white;
            font-weight: 600;
        }

