        function updateStatistics(profile) {
            // Simulate dynamic statistics based on user level and goals
            let wordsLearned = 227;
            let levelsCompleted = 5;
            let ieltsWords = 125;
            
            if (profile.level) {
                const levelMultipliers = {
                    'A1': 1,
                    'A2': 1.5,
                    'B1': 2,
                    'B2': 2.5,
                    'C1': 3
                };
                const multiplier = levelMultipliers[profile.level] || 1;
                wordsLearned = Math.floor(227 * multiplier);
                levelsCompleted = Math.floor(5 * multiplier);
                ieltsWords = Math.floor(125 * multiplier);
            }
            
            // Update statistics display
            const statsElements = document.querySelectorAll('.leaderboard-rank');
            if (statsElements.length >= 4) {
                statsElements[0].parentElement.nextElementSibling.textContent = wordsLearned;
                statsElements[1].parentElement.nextElementSibling.textContent = levelsCompleted;
                statsElements[2].parentElement.nextElementSibling.textContent = ieltsWords;
            }
            
            // Update achievements based on goals
            updateAchievements(profile);
        }

