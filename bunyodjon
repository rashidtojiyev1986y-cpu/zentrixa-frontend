            // Mark selected radio
            document.getElementById('option' + index).checked = true;
            
            userAnswers[currentQuestionIndex] = answer;
            
            // Don't automatically go to next question - let user click "Next" button
        }

        function nextQuestion() {
            currentQuestionIndex++;
            displayQuestion();
        }

        function startTimer() {
            timer = setInterval(function() {
                timeRemaining--;
                updateTimerDisplay();
                
                if (timeRemaining <= 0) {
                    clearInterval(timer);
                    submitQuiz();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const minutes = Math.floor(timeRemaining / 60);
            const seconds = timeRemaining % 60;
            const display = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            
            const timerElement = document.getElementById('timerDisplay');
            timerElement.textContent = display;
            
            timerElement.classList.remove('warning', 'danger');
            if (timeRemaining <= 30) {
                timerElement.classList.add('danger');
            } else if (timeRemaining <= 60) {
                timerElement.classList.add('warning');
            }
        }

        function submitQuiz() {
            clearInterval(timer);
            
            let correct = 0;
            quizQuestions.forEach((question, index) => {
                if (userAnswers[index] === question.answer) {
                    correct++;
                }
            });
            
            displayResults(correct);
        }

        function displayResults(correct) {
            document.getElementById('quizContent').style.display = 'none';
            document.getElementById('quizResults').style.display = 'block';
            
            const total = quizQuestions.length;
            const percentage = Math.round((correct / total) * 100);
            
            document.getElementById('resultScore').textContent = correct + '/' + total;
            
            let message = '';
            if (percentage >= 80) {
                message = 'Ajoyib! Siz bu darajada mukammal!';
            } else if (percentage >= 60) {
                message = 'Yaxshi natija! Davom eting!';
            } else if (percentage >= 40) {
                message = 'Yaxshi, lekin yaxshilash kerak!';
            } else {
                message = 'Ko\'proq mashq qiling!';
            }
            
            document.getElementById('resultMessage').textContent = message;
            
            // Display leaderboard (mock data)
            const leaderboardContainer = document.getElementById('leaderboardContainer');
            leaderboardContainer.innerHTML = '<div class="leaderboard"><h3>🏆 Leaderboard</h3><div class="leaderboard-item"><span class="leaderboard-rank">1. Siz</span><span>' + correct + '/' + total + '</span></div><div class="leaderboard-item"><span class="leaderboard-rank">2. Ali</span><span>' + Math.max(correct - 1, 0) + '/' + total + '</span></div><div class="leaderboard-item"><span class="leaderboard-rank">3. Laylo</span><span>' + Math.max(correct - 2, 0) + '/' + total + '</span></div></div>';
        }

        function backToQuizLevel() {
            clearInterval(timer);
            showQuizLevelSelect();
        }

        // IELTS Word Generator
        function generateIELTSWord() {
            const randomWord = IELTS_WORDS[Math.floor(Math.random() * IELTS_WORDS.length)];
            const modal = document.getElementById('ieltsModal');
            const wordText = document.getElementById('ieltsWordText');
            
            wordText.innerHTML = `
                <strong>${randomWord.word}</strong> - ${randomWord.definition}
                
                <br><br>
                
                <em>Misol:</em> ${randomWord.example}
            `;
            
            modal.style.display = 'block';
            updateActiveNav('ielts');
        }

        function closeIELTSModal() {
            document.getElementById('ieltsModal').style.display = 'none';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('ieltsModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }
    </script>

</body>
</html>
