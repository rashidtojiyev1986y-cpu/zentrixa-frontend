        function saveProfile() {
            const name = document.getElementById('userName').value.trim();
            const email = document.getElementById('userEmail').value.trim();
            const age = document.getElementById('userAge').value;
            const level = document.getElementById('userLevel').value;
            const goal = document.getElementById('userGoal').value;
            
            // Validation
            if (!name) {
                alert('Iltimos, ismingizni kiriting!');
                return;
            }
            
            if (email && !isValidEmail(email)) {
                alert('Iltimos, to\'g\'ri email manzil kiriting!');
                return;
            }
            
            if (age && (age < 5 || age > 100)) {
                alert('Yosh 5 dan 100 gacha bo\'lishi kerak!');
                return;
            }
            
            // Create profile object
            const profile = {
                name: name,
                email: email,
                age: age || null,
                level: level || null,
                goal: goal || null,
                joinDate: JSON.parse(localStorage.getItem('zentrixaUserProfile') || '{}').joinDate || new Date().toLocaleDateString('uz-UZ'),
                lastUpdated: new Date().toISOString()
            };
            
            // Save to localStorage
            localStorage.setItem('zentrixaUserProfile', JSON.stringify(profile));
            
            // Update display
            updateProfileDisplay(profile);
            
            // Hide edit form
            document.getElementById('userInfoSection').style.display = 'block';
            document.getElementById('editFormSection').style.display = 'none';
            document.getElementById('editButtonSection').style.display = 'block';
            
            // Show success message
            showSuccessMessage('Profil muvaffaqiyatli saqlandi!');
        }

